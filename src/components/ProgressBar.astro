---
// ============================================================================
//  ProgressBar.astro  —  a thin "how far along" bar for guided builds
// ============================================================================
//
//  PURPOSE: shows a percent-complete bar (with an accessible label) for a
//  guided build you're working through. Used on project cards and on the
//  project page. Set the number via the `progress` frontmatter field.
// ============================================================================

interface Props {
  /** 0–100. */
  value: number;
  /** Slightly larger bar + visible % when true (used on the project page). */
  large?: boolean;
}

const { value, large = false } = Astro.props;
// Clamp defensively so a stray value never overflows the track.
const pct = Math.max(0, Math.min(100, Math.round(value)));
---

<div class="w-full">
  <div class="mb-1 flex items-center justify-between text-xs">
    <span class="font-semibold uppercase tracking-wider text-accent-500">In&nbsp;progress</span>
    <span class="font-medium text-slate-500 tabular-nums dark:text-slate-400">{pct}%</span>
  </div>
  <div
    class:list={['w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800', large ? 'h-2.5' : 'h-1.5']}
    role="progressbar"
    aria-valuenow={pct}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label={`Progress: ${pct}% complete`}
  >
    <div class="h-full rounded-full bg-accent-500 transition-all" style={`width: ${pct}%`}></div>
  </div>
</div>
