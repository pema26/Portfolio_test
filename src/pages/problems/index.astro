---
// ============================================================================
//  src/pages/problems/index.astro  —  the PROBLEMS SOLVED page  ("/problems")
// ============================================================================
//
//  WHAT'S HERE: three parts —
//    1. A "Competitive profiles" card linking out to my Codeforces account so
//       visitors can see my live rating and history.
//    2. A search box that filters the worked solutions live (handy as the list
//       grows).
//    3. A showcase of individual solved problems from the `challenges`
//       collection, grouped by source (Codeforces, freeCodeCamp, …) and
//       numbered "Problem 1, 2, 3…" within each source. Add one by dropping a
//       new Markdown file in src/content/challenges/ — see the README.
// ============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import ChallengeCard from '../../components/ChallengeCard.astro';
import { getCollection } from 'astro:content';

// Load every challenge.
const challenges = await getCollection('challenges');

// Group them by their `source` so each platform gets its own sub-section.
const bySource = new Map<string, typeof challenges>();
for (const challenge of challenges) {
  const list = bySource.get(challenge.data.source) ?? [];
  list.push(challenge);
  bySource.set(challenge.data.source, list);
}

// Build a display model: one group per source, its problems ordered oldest →
// newest and numbered "Problem 1, 2, 3…" so the numbering is stable as new
// problems are added.
const groups = [...bySource.keys()]
  .sort()
  .map((source) => ({
    source,
    items: [...bySource.get(source)!]
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
      .map((challenge, i) => ({ challenge, label: `Problem ${i + 1}` })),
  }));
---

<BaseLayout
  title="Problems solved — [[YOUR_NAME]]"
  description="Competitive programming and coding challenges — my Codeforces profile, plus worked solutions with complexity analysis."
>
  <h1 class="font-serif text-3xl font-bold text-slate-900 dark:text-white">Problems solved</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-400">
    Where I sharpen algorithms and data-structures skills — my competitive
    profile, and worked solutions comparing my approach with an AI's.
  </p>

  <!-- ===================== COMPETITIVE PROFILES ===================== -->
  <section class="mt-10">
    <h2 class="font-serif text-2xl font-semibold text-slate-900 dark:text-white">
      Competitive profiles
    </h2>
    <!-- EDIT HERE: set [[CODEFORCES_URL]] (and the handle/rating) to your real
         account in the README's find-and-replace pass. -->
    <div class="mt-4 max-w-2xl rounded-xl border border-slate-200 p-5 dark:border-slate-800">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="font-semibold text-slate-900 dark:text-white">Codeforces</p>
          <p class="text-sm text-slate-500 dark:text-slate-400">
            Handle <span class="font-medium">[[CODEFORCES_HANDLE]]</span> ·
            current rating <span class="font-medium">[[CODEFORCES_RATING]]</span>
          </p>
        </div>
        <a
          href="[[CODEFORCES_URL]]"
          class="shrink-0 rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-500"
          target="_blank"
          rel="noopener noreferrer"
        >
          View profile &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== WORKED SOLUTIONS ===================== -->
  <section class="mt-12">
    <h2 class="font-serif text-2xl font-semibold text-slate-900 dark:text-white">
      Worked solutions
    </h2>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
      Each one shows the problem, my solution, an AI's solution in Python and
      C++, and a short note on time and space complexity.
    </p>

    {
      challenges.length === 0 ? (
        <p class="mt-6 text-slate-500 dark:text-slate-400">No solutions yet.</p>
      ) : (
        <>
          {/* ---------- Search box ---------- */}
          <div class="mt-6 max-w-md">
            <label for="problem-search" class="sr-only">
              Search problems
            </label>
            <input
              id="problem-search"
              type="search"
              placeholder="Search problems by name, tag, or source…"
              autocomplete="off"
              class="w-full rounded-lg border border-slate-300 bg-white/70 px-4 py-2 text-sm text-slate-800 shadow-sm transition placeholder:text-slate-400 focus:border-accent-400 focus:outline-none focus:ring-2 focus:ring-accent-400/40 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 dark:placeholder:text-slate-500"
            />
          </div>

          {/* ---------- Grouped, numbered problems ---------- */}
          {groups.map((group) => (
            <div class="mt-8" data-source-group>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-accent-500">
                {group.source}
              </h3>
              <div class="mt-4 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                {group.items.map(({ challenge, label }) => (
                  <ChallengeCard
                    id={challenge.id}
                    title={challenge.data.title}
                    description={challenge.data.description}
                    source={challenge.data.source}
                    label={label}
                    date={challenge.data.date}
                    difficulty={challenge.data.difficulty}
                    tags={challenge.data.tags}
                  />
                ))}
              </div>
            </div>
          ))}

          <p id="no-results" class="mt-8 hidden text-slate-500 dark:text-slate-400">
            No problems match your search.
          </p>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  // ==========================================================================
  //  Live search for the worked-solutions list. Typing filters the visible
  //  problem cards (matching name, tags, source, or "Problem N"); a source
  //  heading hides when none of its problems match, and a friendly message
  //  shows when nothing matches at all. Presentation only — no data lives here.
  // ==========================================================================
  function setupProblemSearch() {
    const input = document.getElementById('problem-search') as HTMLInputElement | null;
    if (!input) return;

    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-search]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-source-group]'));
    const emptyMessage = document.getElementById('no-results');

    function apply() {
      const terms = input!.value.trim().toLowerCase().split(/\s+/).filter(Boolean);

      let anyVisible = false;
      cards.forEach((card) => {
        const haystack = card.getAttribute('data-search') ?? '';
        const match = terms.every((t) => haystack.includes(t));
        card.style.display = match ? '' : 'none';
        if (match) anyVisible = true;
      });

      // Hide a whole source group if none of its cards are showing.
      groups.forEach((group) => {
        const anyCard = group
          .querySelectorAll<HTMLElement>('[data-search]');
        const someVisible = Array.from(anyCard).some((c) => c.style.display !== 'none');
        group.style.display = someVisible ? '' : 'none';
      });

      emptyMessage?.classList.toggle('hidden', anyVisible);
    }

    input.addEventListener('input', apply);
    apply();
  }

  setupProblemSearch();
  document.addEventListener('astro:page-load', setupProblemSearch);
</script>
