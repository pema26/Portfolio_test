---
// ============================================================================
//  src/pages/projects/[...slug].astro  —  ONE project's case-study page
// ============================================================================
//
//  WHAT'S HERE: this single file generates a page for EVERY project Markdown
//  file automatically. The "[...slug]" in the filename is Astro's way of
//  saying "make one page per item, using its id as the URL". So
//  src/content/projects/tinyrenderer.md  becomes  /projects/tinyrenderer .
//
//  You almost never edit this file — it's the template all projects share.
//  To change a project's words, edit its Markdown file instead.
// ============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORY_META, STATUS_META } from '../../lib/projectMeta';

// Map a tone name to its badge colours (same scheme as ProjectCard.astro).
const TONES: Record<string, string> = {
  accent: 'bg-accent-100 text-accent-700 dark:bg-accent-900/50 dark:text-accent-300',
  teal: 'bg-teal-100 text-teal-700 dark:bg-teal-900/50 dark:text-teal-300',
  amber: 'bg-amber-100 text-amber-700 dark:bg-amber-900/50 dark:text-amber-300',
  slate: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300',
};

// getStaticPaths tells Astro every page to build (one per project file).
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
// `render` turns the Markdown body into a component we can place on the page.
const { Content } = await render(project);

const category = CATEGORY_META[project.data.category];
const status = STATUS_META[project.data.status];

// Guided builds get a progress bar + a dated devlog; finished mini projects
// get a "Completed" pill. (Flagship projects keep the status pill above.)
const isGuided = project.data.category === 'guided';
const isMiniComplete =
  project.data.category === 'mini-unique' && project.data.status === 'complete';
const progress = project.data.progress;

// Devlog newest-first for display.
const devlog = [...project.data.devlog].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf(),
);

// Format the date nicely (e.g. "March 2026").
const dateLabel = project.data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
function dayLabel(d: Date) {
  return d.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout title={`${project.data.title} — [[YOUR_NAME]]`} description={project.data.description}>
  <!-- Back link -->
  <a href="/projects" class="text-sm font-medium text-accent-500 hover:underline">
    &larr; All projects
  </a>

  <!-- ===================== HEADER ===================== -->
  <header class="mt-4">
    <div class="flex flex-wrap items-center gap-3">
      <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', TONES[category.tone]]}>
        {category.label}
      </span>
      {
        status && (
          <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', TONES[status.tone]]}>
            {status.label}
          </span>
        )
      }
      {
        isMiniComplete && (
          <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-300">
            <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
            </svg>
            Completed
          </span>
        )
      }
      <time class="text-sm text-slate-500 dark:text-slate-400">{dateLabel}</time>
    </div>

    {/* Guided builds show a progress bar under the header meta. */}
    {
      isGuided && typeof progress === 'number' && (
        <div class="mt-4 max-w-sm">
          <ProgressBar value={progress} large />
        </div>
      )
    }

    <h1 class="mt-3 font-serif text-3xl font-bold text-slate-900 dark:text-white">
      {project.data.title}
    </h1>
    <p class="mt-2 text-lg text-slate-600 dark:text-slate-300">
      {project.data.description}
    </p>

    <!-- Tags -->
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {
        project.data.tags.map((tag) => (
          <li class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-400">
            {tag}
          </li>
        ))
      }
    </ul>

    <!-- Optional external links (only show if present in the frontmatter). -->
    <div class="mt-5 flex flex-wrap gap-3">
      {
        project.data.demoUrl && (
          <a
            href={project.data.demoUrl}
            class="rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-500"
            target="_blank"
            rel="noopener noreferrer"
          >
            Live demo &rarr;
          </a>
        )
      }
      {
        project.data.githubUrl && (
          <a
            href={project.data.githubUrl}
            class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-accent-400 hover:text-accent-500 dark:border-slate-700 dark:text-slate-200"
            target="_blank"
            rel="noopener noreferrer"
          >
            View code
          </a>
        )
      }
    </div>
  </header>

  <!-- ===================== CASE-STUDY BODY ===================== -->
  <!-- This renders the Markdown you wrote below the frontmatter fence. -->
  <article class="prose-content mt-8 text-slate-700 dark:text-slate-300">
    <Content />
  </article>

  <!-- ===================== DEVLOG (guided builds only) ===================== -->
  <!-- A day-by-day log of what got done. Add entries in this project's
       Markdown frontmatter under `devlog:` — each is a { date, summary }. -->
  {
    isGuided && (
      <section class="mt-12 border-t border-slate-200 pt-8 dark:border-slate-800">
        <h2 class="font-serif text-2xl font-semibold text-slate-900 dark:text-white">Devlog</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          What I worked on, day by day.
        </p>

        {devlog.length === 0 ? (
          <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
            No entries yet — I'll add them as I work through this build.
          </p>
        ) : (
          <ol class="mt-6 space-y-5">
            {devlog.map((entry, i) => (
              <li class="relative border-l-2 border-slate-200 pl-5 dark:border-slate-800">
                <span class="absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-accent-500" aria-hidden="true" />
                <div class="flex flex-wrap items-baseline gap-x-3">
                  <span class="text-sm font-semibold text-slate-900 dark:text-white">
                    Day {devlog.length - i}
                  </span>
                  <time class="text-xs text-slate-500 dark:text-slate-400">{dayLabel(entry.date)}</time>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                  {entry.summary}
                </p>
              </li>
            ))}
          </ol>
        )}
      </section>
    )
  }
</BaseLayout>
